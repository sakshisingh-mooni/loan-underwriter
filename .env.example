# .env.example
# ------------
# Copy this file to .env and fill in your keys BEFORE running locally.
# On Azure App Service, set these as Application Settings (Environment Variables)
# under App Service → Settings → Environment variables.
# NEVER commit .env to git.

# ── Required: Groq LLM ────────────────────────────────────────────────────────
# Free key at console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ── Required: Langfuse Observability ─────────────────────────────────────────
# Free keys at cloud.langfuse.com → your project → Settings → API Keys
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Deployment environment ────────────────────────────────────────────────────
# "development" → MemorySaver checkpointer (default, no DB needed)
# "production"  → PostgresSaver checkpointer (requires DATABASE_URL below)
#
# IMPORTANT FOR AZURE: set to "production" to survive container restarts.
# MemorySaver is in-process RAM — a restart wipes all HITL checkpoints and
# any in-flight Refer cases will be lost. PostgresSaver persists them in Azure
# PostgreSQL so the HITL resume survives restarts and scale events.
APP_ENV=development

# ── Required only when APP_ENV=production ────────────────────────────────────
# Azure PostgreSQL Flexible Server connection string.
# Format: postgresql://user:password@host:5432/dbname?sslmode=require
#
# IMPORTANT: use postgresql:// — NOT postgresql+psycopg://
# The +psycopg dialect prefix is SQLAlchemy-only syntax. psycopg3's
# ConnectionPool uses libpq conninfo URIs directly and will throw
# "invalid connection option "+psycopg"" if the prefix is present.
# Reference: https://www.psycopg.org/psycopg3/docs/basic/connect.html
#
# Get from Azure Portal → PostgreSQL Flexible Server → Connection strings
DATABASE_URL=
